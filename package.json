{
  "name": "worldmodel-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run build && electron-builder --dir",
    "prepare:knowledge": "node scripts/extract-knowledge.mjs",
    "dist:linux": "npm run build && electron-builder --linux deb rpm --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "landing:preview": "python3 -m http.server 4174 --directory landing"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.56.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "studio.worldmodel.desktop",
    "productName": "WorldModel Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "target": [
        "dmg"
      ],
      "signIgnore": [
        "\\.lproj(/|$)",
        "\\.pak$"
      ]
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@napi-rs/**/*"
    ],
    "artifactName": "WorldModel-Studio-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "WorldModel Studio <bennix@users.noreply.github.com>",
      "synopsis": "AI research and video creation studio"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "description": "Local multilingual RAG research and media creation studio",
  "author": "WorldModel Studio",
  "homepage": "https://bennix.github.io/WorldAIVideo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennix/WorldAIVideo.git"
  },
  "bugs": {
    "url": "https://github.com/bennix/WorldAIVideo/issues"
  }
}
